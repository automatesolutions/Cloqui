# Cloqui environment variables
# Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser. Everything else stays on the server.

# ── App ────────────────────────────────────────────────────────────────────────
# The public URL people open. Used in emails, OAuth redirects and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (pnpm db:start prints the local values) ─────────────────────────
# API URL of your Supabase project. Local: http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Public "anon"/publishable key. Safe in the browser: RLS decides what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Bypasses RLS. Server only, used for admin tasks like sending invites.
# Never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for Drizzle. Local: postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Production: use the pooler URL (port 6543) from Supabase > Project Settings > Database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# ── OAuth (Phase 1; optional locally) ────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# Microsoft Entra ID > App registrations.
SUPABASE_AUTH_AZURE_CLIENT_ID=
SUPABASE_AUTH_AZURE_SECRET=

# ── Email (Phase 1) ──────────────────────────────────────────────────────────
# "mailpit" (local inbox at http://127.0.0.1:55324, nothing leaves your machine) or "resend" (real email).
EMAIL_TRANSPORT=mailpit
# Resend API key for invites and notifications. Needed when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
# The From address. Must be on a domain you verified in Resend.
EMAIL_FROM="Cloqui <hello@example.com>"

# ── Video storage (Phase 2) ──────────────────────────────────────────────────
# Cloudflare R2 (S3-compatible). Locally, pnpm env:local points these at local Supabase Storage.
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://127.0.0.1:55321/storage/v1/s3
S3_REGION=auto
S3_BUCKET=cloqui-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How long a playback link lives, in seconds. Keep it short.
SIGNED_URL_TTL_SECONDS=300
# Path to ffmpeg/ffprobe for the media worker. Empty = the binaries from ffmpeg-static (dev only).
FFMPEG_PATH=
FFPROBE_PATH=

# ── Live rooms and huddles (Phase 3) ─────────────────────────────────────────
# LiveKit Cloud project, or the local dev server (livekit-server --dev: key "devkey", secret "secret").
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Feature flags ────────────────────────────────────────────────────────────
# Transcription runs whisper.cpp in the media job. Off by default.
TRANSCRIPTION_ENABLED=false
